# mailcli accounts. Copy this file to:
#   Windows: %APPDATA%\mailcli\config
#   Linux:   ~/.config/mailcli/config
#
# Do not put a password or token here. setup stores those in the OS
# credential store (Windows Credential Manager). MAILCLI_PASSWORD overrides
# a stored password for one command and is never written down.

default_account = "home"

[accounts.home]
provider = "gmail"
user = "you@gmail.com"
imap_host = "imap.gmail.com"
imap_port = 993
imap_security = "ssl"
smtp_host = "smtp.gmail.com"
smtp_port = 465
smtp_security = "ssl"
auth = "password"
folder = "INBOX"
tls_verify = true
# pager = false   # print a long message all at once instead of pausing

# A second account, selected with: mailcli --account work inbox
# [accounts.work]
# provider = "outlook"
# user = "you@outlook.com"
